<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Vakya</string>
    <key>CFBundleIdentifier</key>
    <string>com.vakya.app</string>
    <key>CFBundleName</key>
    <string>Vakya</string>
    <key>CFBundleShortVersionString</key>
    <string>0.7.0</string>
    <key>CFBundleVersion</key>
    <string>7</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Microphone permission — shown on first mic access -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Vakya records audio to transcribe your voice. Audio is processed entirely on this device and never sent anywhere.</string>

    <!-- Background audio — allows recording while app is backgrounded -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- Main scene configuration -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>

    <!-- Orientation: portrait only (Phase 1) -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- Launch screen -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- iOS minimum version -->
    <key>MinimumOSVersion</key>
    <string>16.0</string>

    <!-- App Transport Security — network calls are blocked at OS level too -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>
</dict>
</plist>
